# --- Ollama backend (default) ---
OLLAMA_MODEL=qwen3:30b
OLLAMA_HOST=http://localhost:11434

# --- vLLM backend (OpenAI-compatible) ---
# USE_VLLM=true
# VLLM_MODEL=Qwen/Qwen3-30B-A3B
# VLLM_HOST=http://localhost:8000/v1

# --- OpenRouter backend (used only when --model is passed on the CLI) ---
# OPENROUTER_API_KEY=

PARALLEL_LLM_REQUEST_COUNT=4
SAVE_LOCATION=tests/outputs
DEBUG=1
